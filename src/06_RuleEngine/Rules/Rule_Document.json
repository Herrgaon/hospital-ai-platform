{
  "ruleSetId": "DOCUMENT_GENERAL_V1",
  "name": "Quy tắc chung về tên file và metadata văn bản",
  "appliesTo": ["DOCX", "GOOGLE_DOC", "PDF"],
  "version": 1,
  "rules": [
    {
      "id": "FILE_NAME_FORMAT",
      "description": "Tên file không chứa ký tự đặc biệt, không dấu cách kép",
      "type": "REGEX_CHECK",
      "params": { "field": "fileName", "pattern": "^[^\\\\/:*?\"<>|]+$" },
      "severity": "WARNING"
    },
    {
      "id": "METADATA_TITLE_REQUIRED",
      "description": "Văn bản phải có tiêu đề (Title) không rỗng",
      "type": "REQUIRED_FIELD_CHECK",
      "params": { "field": "title" },
      "severity": "ERROR"
    }
  ]
}
